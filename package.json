{
  "name": "design-med-o-de",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/page-dates.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/page-dates.mjs",
    "build": "next build && pagefind --site out --exclude-selectors \".medo-code-block__copy\"",
    "lint": "eslint . --max-warnings 0 && next typegen && tsc --noEmit",
    "test:a11y": "playwright test a11y",
    "test:keyboard": "playwright test keyboard.spec",
    "check:js-budget": "node scripts/js-budget.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "check:samples": "node scripts/check-samples.mjs",
    "check:spelling": "cspell lint --no-progress --no-config-search --show-suggestions",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "smoke:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-data.mjs"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@med-o/design-tokens": "^0.19.0",
    "@med-o/ui": "^0.19.0",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cspell": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "pagefind": "^1.6.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
